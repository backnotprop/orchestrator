{
  "name": "@backnotprop/orchestrator-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "orchestrator": "orchestrator",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@backnotprop/orchestrator-agent": "workspace:*",
    "@backnotprop/orchestrator-cli": "workspace:*",
    "@backnotprop/orchestrator-core": "workspace:*",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.3",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.18.0"
}
