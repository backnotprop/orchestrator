{
  "name": "@backnotprop/orchestrator-agent",
  "version": "0.1.0",
  "description": "Agent-facing tools and parent-agent runtime for Orchestrator.",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "orchestration"
  ],
  "homepage": "https://github.com/backnotprop/orchestrator#readme",
  "bugs": {
    "url": "https://github.com/backnotprop/orchestrator/issues"
  },
  "license": "BUSL-1.1",
  "author": "Michael Ramos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backnotprop/orchestrator.git",
    "directory": "packages/agent"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./instructions": {
      "types": "./dist/instructions.d.ts",
      "import": "./dist/instructions.js"
    },
    "./run-events": {
      "types": "./dist/run-events.d.ts",
      "import": "./dist/run-events.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@backnotprop/orchestrator-core": "workspace:*",
    "@earendil-works/pi-coding-agent": "^0.79.6",
    "typebox": "^1.1.38"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
